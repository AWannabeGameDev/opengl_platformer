#version 460 core

// regular attributes
layout (location = 0) in vec3 position;

// instanced attributes
layout (location = 1) in mat4 transform;
layout (location = 5) in vec4 color;

uniform mat4 view;
uniform mat4 projection;

out vec4 fragColor;

void main()
{
    gl_Position = projection * view * transform * vec4(position, 1.0f);
    fragColor = color;
}